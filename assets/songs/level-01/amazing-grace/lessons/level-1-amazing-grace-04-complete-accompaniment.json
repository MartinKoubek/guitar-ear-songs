{
  "schemaVersion": 2,
  "title": "Amazing Grace - The Complete Accompaniment",
  "bpm": 48,
  "beatsPerMeasure": 3,
  "showChordNames": true,
  "chordFingerings": {
    "G": "Partial G: middle finger on low E fret 3, ring finger on high E fret 3; G and B open. Do not play A or D.",
    "C": "Partial C: ring finger on A fret 3, index on B fret 1; G and high E open. Do not play the D or low E strings.",
    "D": "Open D: index on G fret 2, middle on high E fret 2, ring on B fret 3; D open. Do not play A or low E."
  },
  "lesson": {
    "instructions": "Count 1-and-2-and-3-and. Pluck bass, G, B, G, high E, B as six even eighth notes: p-i-m-i-a-m. Thumb p plays the bass; i plays G, m plays B and a plays high E. Each note is separate; do not pinch two strings together. After the two count-in bars, keep the guitar silent for one pickup bar. If singing, start the first syllable of Amazing on beat 3 of that bar; start the guitar on the next downbeat. Play the full sixteen-bar accompaniment, rest for one bar, then repeat. Start Amazing again on beat 3 of that rest bar. Hold me and see across five beats; leave a breath after see. Keep the picking even during chord changes. This is accompaniment for singing or humming, not the sung melody played on the guitar. First learn the guitar part alone; add singing later. Microphone feedback is intended for the guitar and may be affected by singing.",
    "selfPaced": false,
    "defaultSound": "beat",
    "previewMelody": true
  },
