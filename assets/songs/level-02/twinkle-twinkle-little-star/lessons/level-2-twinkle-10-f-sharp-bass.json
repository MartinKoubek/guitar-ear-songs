{
  "schemaVersion": 2,
  "title": "Twinkle, Twinkle, Little Star - Optional: The F-Sharp Bass",
  "bpm": 40,
  "beatsPerMeasure": 4,
  "showChordNames": true,
  "lesson": {
    "instructions": "This optional variation changes only the D bass: use F-sharp on low E fret 2 instead of open D. Prepare the F-sharp bass alone, then practise the D/F#-G change twice. Keep the same melody, offbeat open-D fills and rhythm. No left-hand thumb-over grip or full barre is required. After the preparation, play the complete twelve-bar tune twice, with one full rest bar between the performances. The first full tune starts at bar 10, including the two count-in bars. Vertically aligned TAB numbers play together. Play only written notes; unclear voices may remain yellow.",
    "selfPaced": false,
    "defaultSound": "beat",
    "previewMelody": true
  },
